# Copier ce fichier en .env puis renseigner les valeurs (ne jamais committer .env).

# Supabase → Project Settings → API Keys (clé « publishable », jamais la clé secrète)
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<cle>

# Uniquement pour `npm run import:legacy` : Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
