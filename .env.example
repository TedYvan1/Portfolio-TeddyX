# Database - PostgreSQL connection string
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Auth - long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Admin seed (optional - used by `npm run seed` to create the first admin user)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# App
PORT=3000
NODE_ENV=development
