# Database - Supabase Postgres
# Get from Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exposed to Vite (same values, VITE_ prefix)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Auth - long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Admin seed (optional - used by `npm run seed` to create the first admin user)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# App
PORT=3000
NODE_ENV=development
